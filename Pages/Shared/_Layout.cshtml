<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniBoard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-dark" asp-area="" asp-page="/Index">
                    <span class="badge bg-primary text-white rounded-3 me-2 px-2 py-1 fs-5">U</span>
                    <span>UniBoard</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold" asp-area="" asp-page="/Index">Ogłoszenia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold" asp-area="" asp-page="/MyAnnouncements">Moje ogłoszenia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold" asp-area="" asp-page="/Favorites">Ulubione</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a class="btn btn-warning fw-bold text-white px-3 shadow-sm rounded-3" asp-area="" asp-page="/Announcements/Create">
                            + Dodaj ogłoszenie
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top bg-white text-muted py-3 mt-auto">
        <div class="container text-center text-md-start d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                &copy; 2026 <strong>UniBoard</strong> - Elektroniczna tablica ogłoszeń
            </div>
            <div class="mt-2 mt-md-0">
                <a class="text-decoration-none text-muted me-3" asp-area="" asp-page="/Privacy">Prywatność</a>
                <a class="text-decoration-none text-muted" asp-area="" asp-page="/Contact">Kontakt</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>