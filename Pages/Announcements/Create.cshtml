@page
@model UniBoard.Pages.Announcements.CreateModel
@{
    ViewData["Title"] = "Dodaj ogłoszenie";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h2 class="fw-bold text-dark mb-1">Dodaj ogłoszenie</h2>
                <p class="text-muted mb-4">Autor i data dodania zostaną przypisane automatycznie.</p>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="np. Sprzedam podręcznik do analizy" />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.CategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="0">-- wybierz kategorię --</option>
                        </select>
                        <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="6"
                                  placeholder="Opisz, co oferujesz lub czego szukasz"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-5 mb-3">
                            <label asp-for="Input.Price" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Price" type="number" min="0" max="100000" step="1" class="form-control"
                                   placeholder="puste = za darmo" />
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-7 mb-3">
                            <label asp-for="Input.Contact" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Contact" type="email" class="form-control" />
                            <span asp-validation-for="Input.Contact" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-page="/Index" class="btn btn-link text-secondary text-decoration-none">&larr; Wróć do ogłoszeń</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Dodaj ogłoszenie</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
