@page
@model ErrorModel
@{
    ViewData["Title"] = Model.ErrorStatusCode switch
    {
        403 => "Brak dostępu (403)",
        404 => "Nie znaleziono strony (404)",
        _ => "Wystąpił błąd"
    };
}

<div class="container text-center mt-5">
    @if (Model.ErrorStatusCode == 403)
    {
        <h1 class="display-1 fw-bold text-danger">403</h1>
        <h2 class="mb-3">Brak dostępu</h2>
        <p class="lead text-muted mb-4">Nie masz uprawnień do wyświetlenia tej strony lub wykonania tej operacji.</p>
    }
    else if (Model.ErrorStatusCode == 404)
    {
        <h1 class="display-1 fw-bold text-warning">404</h1>
        <h2 class="mb-3">Nie znaleziono strony</h2>
        <p class="lead text-muted mb-4">Strona lub ogłoszenie, którego szukasz, nie istnieje lub zostało usunięte.</p>
    }
    else
    {
        <h1 class="display-4 text-danger">Wystąpił błąd</h1>
        <p class="lead text-muted mb-4">Przepraszamy, coś poszło nie tak podczas przetwarzania żądania.</p>
    }

    <a asp-page="/Index" class="btn btn-primary">Wróć na stronę główną</a>
</div>