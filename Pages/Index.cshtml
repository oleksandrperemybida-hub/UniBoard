@page
@model IndexModel
@{
    ViewData["Title"] = "Ogłoszenia";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="fw-bold text-dark mb-0">Ogłoszenia</h1>
            <span class="text-muted">Liczba ogłoszeń: @Model.TotalCount</span>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Announcements/Create" class="btn btn-primary fw-semibold">+ Dodaj ogłoszenie</a>
        }
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
        </div>
    }

    @if (!Model.Announcements.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5 mb-2">Nie ma jeszcze żadnych ogłoszeń.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Announcements/Create">Dodaj pierwsze ogłoszenie</a>
            }
            else
            {
                <span><a asp-area="Identity" asp-page="/Account/Login">Zaloguj się</a>, aby dodać ogłoszenie.</span>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var a in Model.Announcements)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold">
                                    @(a.Category?.Name ?? "Inne")
                                </span>
                            </div>
                            <h5 class="card-title fw-bold text-dark">@a.Title</h5>
                            <p class="card-text text-secondary small flex-grow-1">@IndexModel.Shorten(a.Description)</p>
                            <div class="mb-2">
                                @if (a.Price.HasValue && a.Price.Value > 0)
                                {
                                    <span class="fs-5 fw-bold text-success">@a.Price.Value.ToString("N0") zł</span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-muted">Za darmo / Oddam</span>
                                }
                            </div>
                            <a asp-page="/Announcements/Details" asp-route-id="@a.Id" class="stretched-link"
                               aria-label="Szczegóły ogłoszenia @a.Title"></a>
                        </div>
                        <div class="card-footer bg-white border-0 text-muted small pt-0 pb-3 px-3">
                            @IndexModel.AuthorName(a.Author) · @a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Stronicowanie ogłoszeń" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Index" asp-route-strona="@(Model.CurrentPage - 1)">&laquo; Poprzednia</a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/Index" asp-route-strona="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Index" asp-route-strona="@(Model.CurrentPage + 1)">Następna &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
