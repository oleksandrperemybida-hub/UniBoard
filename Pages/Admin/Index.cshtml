@page
@model UniBoard.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Panel administratora";
}

<div class="container mt-4">
    <h1 class="mb-3">Panel administratora – Zarządzanie ogłoszeniami</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Announcements.Any())
    {
        <div class="alert alert-info">Brak ogłoszeń w bazie danych.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tytuł</th>
                        <th>Kategoria</th>
                        <th>Autor</th>
                        <th>Cena</th>
                        <th>Data dodania</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Announcements)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <a asp-page="/Announcements/Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    @item.Title
                                </a>
                            </td>
                            <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                            <td>@item.Author?.Email</td>
                            <td>@(item.Price.HasValue ? $"{item.Price.Value:0.00} zł" : "Za darmo")</td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline"
                                      onsubmit="return confirm('Czy na pewno chcesz usunąć to ogłoszenie?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>